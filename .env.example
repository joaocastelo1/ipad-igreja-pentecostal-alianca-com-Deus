# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# ---------------------------------------------------------------------------
# Área administrativa
# ---------------------------------------------------------------------------
# Gere com: openssl rand -base64 48 (ou qualquer segredo com 32+ caracteres)
ADMIN_SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais

# Gere com: npm run admin:hash -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$c2FsdA$aGFzaA

# Sal opcional para anonimizar IPs usados no controle de tentativas
RATE_LIMIT_SALT=troque-por-um-valor-aleatorio

# ---------------------------------------------------------------------------
# Banco de dados (opcional em desenvolvimento, recomendado em produção)
# ---------------------------------------------------------------------------
# Se SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY não forem definidos, os pedidos
# de oração são gravados em .data/prayer-requests.json (somente local).
# A chave service_role é secreta: nunca use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRAYER_TABLE=prayer_requests

# ---------------------------------------------------------------------------
# Notificação por e-mail (opcional)
# ---------------------------------------------------------------------------
# Avisa a equipe quando um novo pedido chega. O texto do pedido nunca é enviado
# por e-mail; apenas nome, categoria e data, com link para o painel.
# Crie uma API key em https://resend.com e valide o domínio remetente.
RESEND_API_KEY=
PRAYER_NOTIFICATION_EMAIL=
PRAYER_NOTIFICATION_FROM=Igreja Aliança com Deus <avisos@seudominio.com.br>
